{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run build",
    "watchPatterns": [
      "/src/**",
      "/package.json",
      "/bun.lock",
      "/vite.config.ts",
      "/tsconfig.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "bun .output/server/index.mjs",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
