# Copier en .env (jamais versionné). Toutes les valeurs ont un défaut de développement.

# Base de données : SQLite en local, Postgres en prod (fournie par Railway).
DATABASE_URL=sqlite:///./insightmedics.db
# Fichiers téléversés et artefacts d'audit (volume persistant en prod).
STORAGE_DIR=./storage
# Origines autorisées à appeler l'API (URL du front), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Conservation des fichiers et du détail d'un audit (jours).
FILE_RETENTION_DAYS=30
# Maintenance (purge + audits IA interrompus) toutes les N minutes ; durée max d'un audit IA.
MAINTENANCE_INTERVAL_MINUTES=10
UNLOCK_LEASE_MINUTES=60

# IA : Claude (voir docs/ia-claude.md). Sans clé, l'audit IA est sauté.
ANTHROPIC_API_KEY=
# Valeurs par défaut du code (à ne renseigner que pour les changer) :
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=xhigh
# LLM_MAX_TOKENS=128000

# Clé d'accès admin (CRM + déblocage d'audits). Valeur longue et secrète, ex. :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Mails de notification à l'équipe à chaque formulaire rempli (contact, demande d'audit,
# test gratuit). Envoi via Resend (resend.com) ; vide = aucun mail.
RESEND_API_KEY=
# Destinataires, séparés par des virgules.
NOTIFY_EMAILS=
# NOTIFY_FROM=Insight Medics <notifications@insightmedics.fr>
# NOTIFY_ON_TEST=true
